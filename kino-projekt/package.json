{
  "name": "kino-verwaltung",
  "version": "1.0.0",
  "description": "Hausarbeit Web-Entwicklung",
  "main": "server/src/app.mjs",
  "type": "module",
  "scripts": {
    "start": "node server/src/app.mjs",
    "clean": "rimraf webapp/dist",
    "lint": "semistandard --verbose | snazzy",
    "mkdir:dist": "node -e \"const fs = require('fs'); if (!fs.existsSync('webapp/dist')) fs.mkdirSync('webapp/dist', { recursive: true });\"",
    "copy:html": "node -e \"const fs = require('fs'); fs.copyFileSync('webapp/src/index.html', 'webapp/dist/index.html');\"",
    "build:css:debug": "lessc webapp/src/css/style.less webapp/dist/bundle.css",
    "build:js:debug": "esbuild webapp/src/js/main.js --bundle --outfile=webapp/dist/bundle.js",
    "build:css:prod": "lessc --clean-css webapp/src/css/style.less webapp/dist/bundle.css",
    "build:js:prod": "esbuild webapp/src/js/main.js --bundle | terser --compress --mangle > webapp/dist/bundle.js",
    "predebug": "npm run lint && npm run clean && npm run mkdir:dist && npm run copy:html",
    "debug": "npm run build:css:debug && npm run build:js:debug",
    "prebuild": "npm run lint && npm run clean && npm run mkdir:dist && npm run copy:html",
    "build": "npm run build:css:prod && npm run build:js:prod",
    "fix": "semistandard --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.2",
    "less": "^4.5.1",
    "less-plugin-clean-css": "^1.6.0",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.2",
    "semistandard": "^17.0.0",
    "snazzy": "^9.0.0",
    "terser": "^5.44.1"
  },
  "semistandard": {
    "env": [
      "mocha"
    ],
    "ignore": [
      "webapp/dist/"
    ]
  }
}
